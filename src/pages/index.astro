---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import Ticket from "../components/Ticket.astro";
import Hero from "../components/Hero.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import { categories, heroPicks, products } from "../data/products";
import { site, waLink } from "../data/site";
import phonesImg from "../assets/cat/phones.jpg";
import laptopsImg from "../assets/cat/laptops.jpg";
import consolesImg from "../assets/cat/consoles.jpg";
import audioImg from "../assets/cat/audio.jpg";

const catImages = { phones: phonesImg, laptops: laptopsImg, consoles: consolesImg, audio: audioImg };
const lowest = (id: string) => {
  const prices = products.filter((p) => p.category === id).map((p) => p.price);
  if (!prices.length) throw new Error(`No products in category "${id}"`);
  return Math.min(...prices);
};
const hero = heroPicks.map((n) => {
  const p = products.find((x) => x.name === n);
  if (!p) throw new Error(`heroPicks: no product named "${n}" in products.ts`);
  return p;
});

const hello = waLink("Hi GreenTech, I saw your website. I'm looking for: ");
const findIt = waLink("Hi GreenTech, I saw your website. I can't find this on your list. I'm looking for: ");

const fears = [
  {
    q: "“Is this thing even original?”",
    a: "Every device is checked before it's listed: screen, battery, cameras, ports, buttons. Ask, and we'll send a live video of the exact unit before you pay.",
  },
  {
    q: "“Am I being overcharged?”",
    a: "Our prices are on this page before you message us. No “how much you get?”. Buy online and you pay exactly the price you see.",
  },
  {
    q: "“Will it actually reach me?”",
    a: "We deliver to all 36 states and the FCT. We agree the delivery fee and timing with you on WhatsApp. Or pick it up at our shop for free.",
  },
];

const testimonials = [
  { name: "Tunde A.", where: "Lekki", text: "Swapped my old iPhone 11 for a Pixel 9. Fair valuation, no stress. Delivery to Lekki the same day." },
  { name: "Chinwe O.", where: "Yaba", text: "Got my MacBook Air M2 in 24 hours. Genuine UK Used, exactly as described. Going back for the JBL." },
  { name: "Bola K.", where: "Ikeja", text: "GreenTech is now my go-to. Honest pricing, real specs, and they actually pick up the phone." },
];

const faqs = [
  {
    q: "Are your phones and laptops original?",
    a: "Yes. We check every device before it goes on sale. If you're not sure, ask on WhatsApp for photos or a live video of the exact unit before you buy.",
  },
  {
    q: "What does “UK Used” mean?",
    a: "It's a pre-owned device imported from abroad, usually the UK, that we've tested ourselves. It costs a lot less than brand new. We tell you its exact condition (scratches, battery health) before you buy.",
  },
  {
    q: "Do you deliver outside Lagos?",
    a: "Yes, to all 36 states and the FCT. The fee and delivery time depend on where you are. We agree both with you on WhatsApp, and you pay the delivery fee separately from the device.",
  },
  {
    q: "How do I pay?",
    a: "Tap Buy now on any device and pay securely on Paystack. Or message us on WhatsApp first and ask for a live video of the unit, or come and pay in person at our shop in Computer Village.",
  },
  {
    q: "What if it sells out after I pay?",
    a: "Each unit is one of a kind, so occasionally one sells in the shop just before an online order comes in. If that happens, we tell you on WhatsApp straight away and refund you in full. Or, if you'd like, we help you pick a similar device instead.",
  },
  {
    q: "How does a swap work?",
    a: "Tell us your device's model, storage and condition with the form above. We send you a valuation on WhatsApp. If you're happy with it, you hand over your old device, pay the difference, and take your new one home.",
  },
  {
    q: "Is the price on this page final?",
    a: "Yes. If you buy online, you pay exactly the price on the ticket, nothing added at checkout. Gadget prices in Nigeria follow the dollar, so prices on this page can change from day to day.",
  },
];
---
<Base
  title="GreenTech Gadget Store | Phones & Laptops, Computer Village"
  description="Tested UK-used and new phones, laptops and consoles in Computer Village, Ikeja. Prices upfront, swap your old device, delivery nationwide."
>
  <header class="nav">
    <div class="wrap nav-inner">
      <a href="#top" class="brand" aria-label="GreenTech Gadget Store, back to top">
        <Logo size={34} />
        <span class="brand-word">Green<b>Tech</b></span>
      </a>
      <nav aria-label="Sections">
        <ul class="nav-links">
          <li><a href="#deals">Prices</a></li>
          <li><a href="#swap">Swap</a></li>
          <li><a href="#faq">FAQ</a></li>
          <li><a href="#visit">Visit</a></li>
        </ul>
      </nav>
      <a class="btn btn-primary nav-cta" href={hello} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
        <WhatsAppIcon /> <span>Chat with us</span>
      </a>
    </div>
  </header>

  <main id="main">
    <Hero picks={hero} hello={hello} />

    <!-- CATEGORIES -->
    <section class="cats" aria-label="Shop by category">
      <div class="wrap cats-grid">
        {categories.map((c, i) => (
          <a class="cat" href="#deals" data-filter={c.id} data-reveal style={`--i:${i}`}>
            <Image
              src={catImages[c.id]}
              alt=""
              widths={[360, 560, 800]}
              sizes="(max-width: 700px) 50vw, 25vw"
              loading="lazy"
            />
            <span class="cat-label">
              <span class="cat-name">{c.label}</span>
              <span class="cat-from">from <span class="cur">₦</span>{lowest(c.id).toLocaleString("en-NG")}</span>
              <span class="sr-only">, show in prices</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- FEARS -->
    <section class="section fears">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Why GreenTech</p>
          <h2>We know how buying a gadget in Lagos goes.</h2>
        </div>
        <ol class="fear-list">
          {fears.map((f, i) => (
            <li data-reveal style={`--i:${i}`}>
              <span class="fear-n" aria-hidden="true">0{i + 1}</span>
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- DEALS -->
    <section class="section deals" id="deals">
      <div class="wrap">
        <div class="deals-head">
          <div class="section-head" data-reveal>
            <p class="eyebrow">Today's prices</p>
            <h2>Pick it. Pay for it. It's yours.</h2>
            <p>Tap <strong>Buy now</strong> to pay securely with Paystack. Want to see it first? Tap <strong>Ask</strong> and we'll send a live video of the exact unit on WhatsApp.</p>
          </div>
          <div class="filters" role="group" aria-label="Filter by category" hidden>
            <button type="button" aria-pressed="true" data-filter="all">All</button>
            {categories.map((c) => <button type="button" aria-pressed="false" data-filter={c.id}>{c.label}</button>)}
          </div>
        </div>

        <p class="sr-only" aria-live="polite" id="deal-count"></p>
        <div class="deal-grid">
          {products.map((p, i) => <Ticket product={p} index={i} />)}
        </div>

        <div class="deals-more" data-reveal>
          <p><strong>Don't see it?</strong> This is a selection. Tell us the model and budget, and we'll find it.</p>
          <a class="btn btn-ghost" href={findIt} target="_blank" rel="noopener"><WhatsAppIcon /> Ask for a device</a>
        </div>
        <p class="price-note">Prices follow the dollar and can change from day to day. Buy online and you pay the price on the ticket. Delivery is agreed and paid separately.</p>
      </div>
    </section>

    <!-- CONDITION -->
    <section class="section cond">
      <div class="wrap cond-grid">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Know what you're buying</p>
          <h2>Brand New or UK Used? Here's the difference.</h2>
          <p>Both come tested from us. The difference is the price, and whether someone owned it before you.</p>
        </div>
        <div class="cond-cards">
          <div class="cond-card" data-reveal style="--i:0">
            <span class="stamp stamp-new">Brand New</span>
            <h3>Never used</h3>
            <p>Straight from the manufacturer, for when you want it untouched.</p>
          </div>
          <div class="cond-card" data-reveal style="--i:1">
            <span class="stamp stamp-used">UK Used</span>
            <h3>Pre-owned, tested by us</h3>
            <p>Imported and checked by us: battery, screen, cameras, ports, buttons. Ask us about any unit's exact condition before you buy. It costs a lot less than new.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SWAP -->
    <section class="section swap" id="swap">
      <div class="wrap"><div class="swap-grid">
        <div class="swap-copy" data-reveal>
          <p class="eyebrow">Swap or sell</p>
          <h2>What's your old phone worth? Find out today.</h2>
          <p class="lead">Swap it for something newer and pay only the difference, or sell it to us for cash. We send you a valuation on WhatsApp, and you decide.</p>
          <ol class="steps">
            <li><b>1</b><span>Tell us what you have, with the form.</span></li>
            <li><b>2</b><span>We send you a valuation on WhatsApp.</span></li>
            <li><b>3</b><span>Happy with it? Hand it over, pay the difference, and take your upgrade home.</span></li>
          </ol>
        </div>

        <form class="swap-form" id="swap-form" data-reveal style="--i:1" novalidate>
          <fieldset class="mode">
            <legend class="sr-only">What do you want to do?</legend>
            <label><input type="radio" name="mode" value="swap" checked /> <span>Swap it</span></label>
            <label><input type="radio" name="mode" value="sell" /> <span>Sell for cash</span></label>
          </fieldset>

          <div class="field">
            <label for="f-device">Your device</label>
            <input id="f-device" name="device" required autocomplete="off" placeholder="e.g. iPhone 12 Pro, 128GB" />
            <p class="err" id="f-device-err" role="alert" hidden>Tell us the model so we can value it.</p>
          </div>

          <div class="field">
            <label for="f-condition">Condition</label>
            <select id="f-condition" name="condition">
              <option>Like new, no scratches</option>
              <option selected>Good, light signs of use</option>
              <option>Fair, visible scratches or dents</option>
              <option>Has a fault (screen, battery, etc.)</option>
            </select>
          </div>

          <div class="field" data-swap-only>
            <label for="f-want">What do you want instead? <span class="opt">(optional)</span></label>
            <input id="f-want" name="want" autocomplete="off" placeholder="e.g. iPhone 14 Pro Max" />
          </div>

          <button class="btn btn-primary btn-lg" type="submit"><WhatsAppIcon /> <span data-label>Get my swap value</span></button>
          <p class="form-note">This opens WhatsApp with your details filled in. You send it yourself, and nothing is stored here.</p>
        </form>
      </div></div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="section voices">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <p class="eyebrow">From our customers</p>
          <h2>They came for one gadget. They came back for the next.</h2>
        </div>
        <div class="voice-grid">
          {testimonials.map((t, i) => (
            <figure class="voice" data-reveal style={`--i:${i}`}>
              <blockquote>{t.text}</blockquote>
              <figcaption><b>{t.name}</b> · {t.where}</figcaption>
            </figure>
          ))}
        </div>
        <p class="voices-more">
          See unboxings and deliveries on Instagram:{" "}
          <a href={site.instagram.url} target="_blank" rel="noopener">{site.instagram.handle}</a>
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section faq" id="faq">
      <div class="wrap faq-grid">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Questions</p>
          <h2>Before you ask.</h2>
          <p>Still unsure? <a href={hello} target="_blank" rel="noopener">Message us</a>. A real person replies.</p>
        </div>
        <div class="faq-list">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- VISIT + CLOSE -->
    <section class="section visit" id="visit">
      <div class="wrap">
        <div class="close" data-reveal>
          <Logo size={64} class="close-logo" />
          <h2>Tell us what you want.<br /><span class="hl">We'll tell you straight.</span></h2>
          <div class="close-ctas">
            <a class="btn btn-primary btn-lg" href={hello} target="_blank" rel="noopener"><WhatsAppIcon /> Chat on WhatsApp</a>
            <a class="btn btn-ghost btn-lg" href={`tel:${site.phoneTel}`}>Call {site.phoneDisplay}</a>
          </div>
        </div>

        <div class="visit-grid">
          <div class="visit-item" data-reveal style="--i:0">
            <p class="v-label">Shop</p>
            <p class="v-value">{site.address}</p>
            <a href={site.mapsUrl} target="_blank" rel="noopener">Get directions →</a>
          </div>
          <div class="visit-item" data-reveal style="--i:1">
            <p class="v-label">Open</p>
            <p class="v-value">{site.hours}</p>
            <span class="v-hint">Message first and we'll have your device ready.</span>
          </div>
          <div class="visit-item" data-reveal style="--i:2">
            <p class="v-label">Delivery</p>
            <p class="v-value">All 36 states + FCT</p>
            <span class="v-hint">Fee agreed on WhatsApp, paid separately.</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-inner">
      <p class="brand-word">Green<b>Tech</b> <span>· {site.tagline}</span></p>
      <ul>
        <li><a href={site.instagram.url} target="_blank" rel="noopener">Instagram {site.instagram.handle}</a></li>
        <li><a href={site.x.url} target="_blank" rel="noopener">X {site.x.handle}</a></li>
        <li><a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a></li>
      </ul>
      <p class="foot-small">© {new Date().getFullYear()} {site.name}. Computer Village, Ikeja, Lagos.</p>
    </div>
  </footer>

  <nav class="dock" aria-label="Quick contact">
    <a class="btn btn-primary" href={hello} target="_blank" rel="noopener"><WhatsAppIcon /> WhatsApp us</a>
    <a class="btn btn-ghost" href={`tel:${site.phoneTel}`} aria-label={`Call ${site.phoneDisplay}`}>Call</a>
  </nav>


<script>
  import { waLink } from "../data/site";

  // Scroll reveal. Elements are only hidden when the html.js class is present,
  // and anything that can't be observed is shown straight away.
  const revealAll = () => document.querySelectorAll("[data-reveal]").forEach((el) => el.classList.add("in"));
  if (!("IntersectionObserver" in window)) revealAll();
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add("in");
          io.unobserve(e.target);
        }
      }
    },
    { rootMargin: "0px 0px -8% 0px" },
  );
  document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
  // Safety net: never leave content hidden for long, whatever happens above.
  setTimeout(revealAll, 4000);

  // Category filter. Without JS every deal stays visible and the buttons stay hidden.
  const filters = document.querySelector<HTMLElement>(".filters");
  const tickets = document.querySelectorAll<HTMLElement>(".deal-grid .ticket");
  const count = document.getElementById("deal-count");
  const apply = (cat: string) => {
    let shown = 0;
    tickets.forEach((t) => {
      const match = cat === "all" || t.dataset.category === cat;
      t.hidden = !match;
      if (match) {
        shown++;
        t.classList.add("in");
      }
    });
    filters?.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === cat)));
    if (count) count.textContent = `Showing ${shown} ${shown === 1 ? "device" : "devices"}`;
  };
  if (filters) {
    filters.hidden = false;
    filters.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest("button");
      if (b?.dataset.filter) apply(b.dataset.filter);
    });
  }
  document.querySelectorAll<HTMLAnchorElement>(".cat[data-filter]").forEach((a) =>
    a.addEventListener("click", () => apply(a.dataset.filter!)),
  );
  // Generic links to the price list always show everything.
  document.querySelectorAll<HTMLAnchorElement>('a[href="#deals"]:not([data-filter])').forEach((a) =>
    a.addEventListener("click", () => apply("all")),
  );

  // Swap / sell form: composes a WhatsApp message, nothing is sent anywhere else.
  const form = document.getElementById("swap-form") as HTMLFormElement | null;
  if (form) {
    const label = form.querySelector<HTMLElement>("[data-label]");
    const swapOnly = form.querySelectorAll<HTMLElement>("[data-swap-only]");
    const device = form.elements.namedItem("device") as HTMLInputElement;
    const err = document.getElementById("f-device-err");

    const sync = () => {
      const sell = (form.elements.namedItem("mode") as RadioNodeList).value === "sell";
      swapOnly.forEach((el) => {
        el.hidden = sell;
        el.querySelectorAll("input").forEach((i) => (i.disabled = sell));
      });
      if (label) label.textContent = sell ? "Get my cash offer" : "Get my swap value";
    };
    form.addEventListener("change", sync);
    sync();

    device.addEventListener("input", () => {
      if (device.value.trim()) {
        device.removeAttribute("aria-invalid");
        device.removeAttribute("aria-describedby");
        if (err) err.hidden = true;
      }
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const d = String(data.get("device") ?? "").trim();
      if (!d) {
        device.setAttribute("aria-invalid", "true");
        device.setAttribute("aria-describedby", "f-device-err");
        if (err) err.hidden = false;
        device.focus();
        return;
      }
      const sell = data.get("mode") === "sell";
      const want = String(data.get("want") ?? "").trim();
      const lines = [
        sell ? "Hi GreenTech, I want to sell my device for cash." : "Hi GreenTech, I want to swap my device.",
        `Device: ${d}`,
        `Condition: ${data.get("condition")}`,
      ];
      if (!sell && want) lines.push(`I want: ${want}`);
      lines.push("What can you offer?");
      // A real link click survives popup blockers and in-app browsers better than window.open.
      const a = Object.assign(document.createElement("a"), { href: waLink(lines.join("\n")), target: "_blank", rel: "noopener" });
      document.body.append(a);
      a.click();
      a.remove();
    });
  }
</script>
</Base>

<style>
  /* ---------- Nav ---------- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--nav-bg);
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .nav-inner { display: flex; align-items: center; gap: 1.5rem; height: 3.75rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; }
  .brand-word { font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; letter-spacing: -0.03em; }
  .brand-word b { color: var(--green); font-weight: 600; }
  nav { margin-left: auto; }
  .nav-links { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .nav-links a {
    display: block;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: var(--text-sm);
    color: var(--muted);
    transition: color var(--dur-fast), background-color var(--dur-fast);
  }
  .nav-links a:hover { color: var(--text); background: var(--surface-2); }
  .nav-cta { --h: 2.4rem; font-size: var(--text-sm); }
  @media (max-width: 760px) {
    nav { display: none; }
    .nav-cta { margin-left: auto; }
  }
  @media (max-width: 380px) {
    .nav-cta span { display: none; }
    .nav-cta { padding: 0 0.85rem; }
  }

  /* ---------- Categories ---------- */
  .cats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; }
  .cat {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    isolation: isolate;
    border: 1px solid var(--line);
  }
  .cat :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 700ms var(--ease-out); z-index: -2; }
  .cat::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgba(6, 10, 6, 0.92) 8%, rgba(6, 10, 6, 0.2) 55%, transparent); }
  .cat:hover :global(img) { transform: scale(1.05); }
  .cat-label { color: #fff; position: absolute; left: 1.1rem; right: 1.1rem; bottom: 1rem; display: flex; flex-direction: column; gap: 0.15rem; }
  .cat-name { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; letter-spacing: -0.03em; line-height: 1; }
  .cat-from { font-family: var(--font-mono); font-size: 0.8rem; color: #cfeedd; }
  @media (max-width: 700px) {
    .cats-grid { grid-template-columns: repeat(2, 1fr); }
    .cat { aspect-ratio: 1; }
  }

  /* ---------- Fears ---------- */
  .fear-list { list-style: none; padding: 0; margin: clamp(2.5rem, 5vw, 4rem) 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .fear-list li { background: var(--bg); padding: clamp(1.5rem, 3vw, 2.5rem); display: flex; flex-direction: column; gap: 0.9rem; }
  .fear-n { font-family: var(--font-mono); font-size: 0.8rem; color: var(--green); }
  .fear-list h3 { font-size: var(--text-2xl); letter-spacing: -0.025em; line-height: 1.05; }
  .fear-list p { color: var(--muted); }
  @media (max-width: 860px) { .fear-list { grid-template-columns: 1fr; } }

  /* ---------- Deals ---------- */
  .deals { background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--surface-2) 60%, transparent) 18%, color-mix(in srgb, var(--surface-2) 60%, transparent) 82%, transparent); }
  .deals-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 2rem; }
  .deals-head strong { color: var(--text); }
  .filters { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .filters[hidden] { display: none; }
  .filters button {
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: 500;
    transition: background-color var(--dur-fast), color var(--dur-fast), border-color var(--dur-fast);
  }
  .filters button:hover { color: var(--text); border-color: var(--mint); }
