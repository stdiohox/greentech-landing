---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import Hero from "../components/Hero.astro";
import ProductCard from "../components/ProductCard.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Dock from "../components/Dock.astro";
import { categories, heroPicks, products, type Category } from "../data/products";
import { site, waLink } from "../data/site";
import { productImage } from "../lib/images";

// Category tiles use an accurate product photo from that category.
const catPhoto: Record<Category, ImageMetadata | undefined> = {
  phones: productImage("iphone-14-pro-max-128gb"),
  laptops: productImage("macbook-air-m2"),
  consoles: productImage("ps5-disc"),
  audio: productImage("airpods-pro-2"),
};
const lowest = (id: string) => {
  const prices = products.filter((p) => p.category === id).map((p) => p.price);
  if (!prices.length) throw new Error(`No products in category "${id}"`);
  return Math.min(...prices);
};
const countIn = (id: string) => products.filter((p) => p.category === id).length;
const hero = heroPicks.map((n) => {
  const p = products.find((x) => x.name === n);
  if (!p) throw new Error(`heroPicks: no product named "${n}" in products.ts`);
  return p;
});

const hello = waLink("Hi GreenTech, I saw your website. I'm looking for: ");
const findIt = waLink("Hi GreenTech, I saw your website. I can't find this on your list. I'm looking for: ");

const testimonials = [
  { name: "Tunde A.", where: "Lekki", text: "Swapped my old iPhone 11 for a Pixel 9. Fair valuation, no stress. Delivery to Lekki the same day." },
  { name: "Chinwe O.", where: "Yaba", text: "Got my MacBook Air M2 in 24 hours. Genuine UK Used, exactly as described. Going back for the JBL." },
  { name: "Bola K.", where: "Ikeja", text: "GreenTech is now my go-to. Honest pricing, real specs, and they actually pick up the phone." },
];

const faqs = [
  { q: "Are your phones and laptops original?", a: "Yes. We check every device before it goes on sale. If you're not sure, ask on WhatsApp for photos or a live video of the exact unit before you buy." },
  { q: "What does “UK used” mean?", a: "It's a pre-owned device imported from abroad, usually the UK, that we've tested ourselves. It costs a lot less than brand new. We tell you its exact condition (scratches, battery health) before you buy." },
  { q: "Do you deliver outside Lagos?", a: "Yes, to all 36 states and the FCT. The fee and delivery time depend on where you are. We agree both with you on WhatsApp, and you pay the delivery fee separately from the device." },
  { q: "How do I pay?", a: "Tap Buy on any device and pay securely on Paystack. Or message us on WhatsApp first and ask for a live video of the unit, or come and pay in person at our shop in Computer Village." },
  { q: "What if it sells out after I pay?", a: "Each unit is one of a kind, so occasionally one sells in the shop just before an online order comes in. If that happens, we tell you on WhatsApp straight away and refund you in full. Or, if you'd like, we help you pick a similar device instead." },
  { q: "How does a swap work?", a: "Tell us your device's model, storage and condition with the swap form. We send you a valuation on WhatsApp. If you're happy with it, you hand over your old device, pay the difference, and take your new one home." },
  { q: "Is the price on this page final?", a: "Yes. If you buy online, you pay exactly the price shown, nothing added at checkout. Gadget prices in Nigeria follow the dollar, so prices on this page can change from day to day." },
];
---
<Base
  title="UK Used & New iPhones, Phones & Laptops | GreenTech Ikeja"
  description="Tested UK-used and new phones, laptops and consoles in Computer Village, Ikeja. Prices upfront, swap your old device, delivery nationwide."
>
  <SiteHeader hello={hello} />

  <main id="main">
    <Hero picks={hero} hello={hello} />

    <!-- CATEGORIES: an Apple-store style shelf -->
    <section class="section cats" aria-labelledby="cats-title">
      <div class="wrap">
        <h2 class="h2" id="cats-title" data-reveal>Shop by category. <span class="tone">Find your next one.</span></h2>
        <div class="cats-row">
          {categories.map((c, i) => (
            <a class="cat" href="#deals" data-filter={c.id} data-reveal style={`--i:${i}`}>
              <span class="cat-media">
                {catPhoto[c.id] && <Image src={catPhoto[c.id]!} alt="" widths={[240, 360, 480, 720]} quality={70} sizes="(max-width: 760px) 44vw, 280px" loading="lazy" />}
              </span>
              <span class="cat-text">
                <span class="cat-name">{c.label}</span>
                <span class="cat-meta">{countIn(c.id)} devices · from <span class="cur">₦</span>{lowest(c.id).toLocaleString("en-NG")}</span>
                <span class="sr-only">, show in the price list</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- WHY: asymmetric bento -->
    <section class="section why" aria-labelledby="why-title">
      <div class="wrap">
        <h2 class="h2" id="why-title" data-reveal>The GreenTech difference. <span class="tone">Buy without the worry.</span></h2>
        <div class="bento">
          <article class="tile tile-big" data-reveal style="--i:0">
            <div class="tile-core">
              <p class="tile-kicker">Is it original?</p>
              <h3>Every device is checked before it's listed.</h3>
              <p>Screen, battery, cameras, ports and buttons. Not sure? Ask on WhatsApp and we'll send a live video of the exact unit before you pay.</p>
              <ul class="checks" aria-label="What we check">
                <li>Screen</li><li>Battery</li><li>Cameras</li><li>Ports</li><li>Buttons</li>
              </ul>
            </div>
          </article>
          <article class="tile" data-reveal style="--i:1">
            <div class="tile-core">
              <p class="tile-kicker">Am I overpaying?</p>
              <h3>The price is on the page.</h3>
              <p>No “how much you get?”. Buy online and you pay exactly what you see.</p>
            </div>
          </article>
          <article class="tile" data-reveal style="--i:2">
            <div class="tile-core">
              <p class="tile-kicker">Will it reach me?</p>
              <h3>Delivered to all 36 states.</h3>
              <p>We agree the fee and timing on WhatsApp. Or pick it up in Ikeja for free.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- DEALS -->
    <section class="section deals" id="deals" aria-labelledby="deals-title">
      <div class="wrap">
        <div class="deals-head">
          <h2 class="h2" id="deals-title" data-reveal>All devices. <span class="tone">Take your pick.</span></h2>
          <div class="filters" role="group" aria-label="Filter by category" hidden>
            <button type="button" aria-pressed="true" data-filter="all">All</button>
            {categories.map((c) => <button type="button" aria-pressed="false" data-filter={c.id}>{c.label}</button>)}
          </div>
        </div>
        <p class="deals-sub" data-reveal><b>Buy</b> pays securely with Paystack. <b>Ask</b> gets you a live video of the exact unit on WhatsApp first.</p>

        <p class="sr-only" aria-live="polite" id="deal-count"></p>
        <div class="deal-grid">
          {products.map((p, i) => <ProductCard product={p} index={i} />)}
        </div>

        <div class="more" data-reveal>
          <p><b>Don't see it?</b> <span class="tone-text">This is a selection. Tell us the model and your budget, and we'll find it.</span></p>
          <a class="link" href={findIt} target="_blank" rel="noopener">Ask for a device <span aria-hidden="true">›</span></a>
        </div>
        <p class="fine">Prices follow the dollar and can change from day to day. Buy online and you pay the price shown. Delivery is agreed and paid separately.</p>
      </div>
    </section>

    <!-- CONDITION -->
    <section class="section cond" aria-labelledby="cond-title">
      <div class="wrap">
        <h2 class="h2" id="cond-title" data-reveal>Brand new or UK used. <span class="tone">Know the difference.</span></h2>
        <div class="cond-grid">
          <article class="cond-card" data-reveal style="--i:0">
            <span class="pill pill-new">Brand new</span>
            <h3>Never used.</h3>
            <p>Straight from the manufacturer, for when you want it untouched.</p>
          </article>
          <article class="cond-card" data-reveal style="--i:1">
            <span class="pill pill-used">UK used</span>
            <h3>Pre-owned. Tested by us.</h3>
            <p>Imported and checked by us: battery, screen, cameras, ports, buttons. It costs a lot less than new, and you can ask about any unit's exact condition before you buy.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- SWAP: double-bezel panel -->
    <section class="section swap" id="swap" aria-labelledby="swap-title">
      <div class="wrap">
        <div class="shell">
          <div class="shell-core swap-grid">
            <div class="swap-copy" data-reveal>
              <h2 class="h2" id="swap-title">Swap it. <span class="tone">Upgrade it.</span></h2>
              <p class="lead">Trade in your old phone for something newer and pay only the difference, or sell it to us for cash. We send you a valuation on WhatsApp, and you decide.</p>
              <ol class="steps">
                <li><b>1</b><span>Tell us what you have.</span></li>
                <li><b>2</b><span>Get a valuation on WhatsApp.</span></li>
                <li><b>3</b><span>Hand it over, pay the difference, take your upgrade home.</span></li>
              </ol>
            </div>

            <form class="swap-form" id="swap-form" data-reveal style="--i:1" novalidate>
              <fieldset class="mode">
                <legend class="sr-only">What do you want to do?</legend>
                <label><input type="radio" name="mode" value="swap" checked /> <span>Swap it</span></label>
                <label><input type="radio" name="mode" value="sell" /> <span>Sell for cash</span></label>
              </fieldset>

              <div class="field">
                <label for="f-device">Your device</label>
                <input id="f-device" name="device" required autocomplete="off" placeholder="e.g. iPhone 12 Pro, 128GB" />
                <p class="err" id="f-device-err" role="alert" hidden>Tell us the model so we can value it.</p>
              </div>

              <div class="field">
                <label for="f-condition">Condition</label>
                <select id="f-condition" name="condition">
                  <option>Like new, no scratches</option>
                  <option selected>Good, light signs of use</option>
                  <option>Fair, visible scratches or dents</option>
                  <option>Has a fault (screen, battery, etc.)</option>
                </select>
              </div>

              <div class="field" data-swap-only>
                <label for="f-want">What do you want instead? <span class="opt">(optional)</span></label>
                <input id="f-want" name="want" autocomplete="off" placeholder="e.g. iPhone 14 Pro Max" />
              </div>

              <button class="btn btn-primary btn-lg" type="submit"><WhatsAppIcon /> <span data-label>Get my swap value</span></button>
              <p class="form-note">Opens WhatsApp with your details filled in. You send it yourself; nothing is stored here.</p>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="section voices" aria-labelledby="voices-title">
      <div class="wrap">
        <h2 class="h2" id="voices-title" data-reveal>From our customers. <span class="tone">In their words.</span></h2>
        <div class="voice-grid">
          {testimonials.map((t, i) => (
            <figure class="voice" data-reveal style={`--i:${i}`}>
              <blockquote>“{t.text}”</blockquote>
              <figcaption><b>{t.name}</b> <span>{t.where}</span></figcaption>
            </figure>
          ))}
        </div>
        <p class="voices-more" data-reveal>
          Unboxings and deliveries on Instagram:{" "}
          <a class="link" href={site.instagram.url} target="_blank" rel="noopener">{site.instagram.handle} <span aria-hidden="true">›</span></a>
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section faq" id="faq" aria-labelledby="faq-title">
      <div class="wrap faq-grid">
        <div data-reveal>
          <h2 class="h2" id="faq-title">Questions? <span class="tone">Answers.</span></h2>
          <p class="faq-help">Still unsure? <a class="link" href={hello} target="_blank" rel="noopener">Message us <span aria-hidden="true">›</span></a> A real person replies.</p>
        </div>
        <div class="faq-list">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- VISIT + CLOSE: bento -->
    <section class="section visit" id="visit" aria-labelledby="visit-title">
      <div class="wrap">
        <h2 class="h2" id="visit-title" data-reveal>Come and see it. <span class="tone">Or have it delivered.</span></h2>
        <div class="visit-bento">
          <article class="vtile vtile-main" data-reveal style="--i:0">
            <Logo size={40} />
            <h3>{site.address}</h3>
            <p>{site.hours}. Message us first and we'll have your device ready to test.</p>
            <a class="link" href={site.mapsUrl} target="_blank" rel="noopener">Get directions <span aria-hidden="true">›</span></a>
          </article>
          <article class="vtile" data-reveal style="--i:1">
            <h3>Talk to a person.</h3>
            <p>WhatsApp or call, Mon–Sat. We pick up.</p>
            <div class="vtile-ctas">
              <a class="btn btn-primary" href={hello} target="_blank" rel="noopener"><WhatsAppIcon /> WhatsApp</a>
              <a class="link" href={`tel:${site.phoneTel}`}>Call {site.phoneDisplay} <span aria-hidden="true">›</span></a>
            </div>
          </article>
          <article class="vtile" data-reveal style="--i:2">
            <h3>Delivered nationwide.</h3>
            <p>All 36 states and the FCT. Fee and timing agreed on WhatsApp, paid separately from the device.</p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <Dock hello={hello} />

<script>
  import { waLink } from "../data/site";

  // Scroll reveal. Elements are only hidden when the html.js class is present,
  // and anything that can't be observed is shown straight away.
  const revealAll = () => document.querySelectorAll("[data-reveal]").forEach((el) => el.classList.add("in"));
  if (!("IntersectionObserver" in window)) revealAll();
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add("in");
          io.unobserve(e.target);
        }
      }
    },
    { rootMargin: "0px 0px -8% 0px" },
  );
  document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
  // Safety net: never leave content hidden for long, whatever happens above.
  setTimeout(revealAll, 4000);

  // Category filter. Without JS every device stays visible and the buttons stay hidden.
  const filters = document.querySelector<HTMLElement>(".filters");
  const cards = document.querySelectorAll<HTMLElement>(".deal-grid .card");
  const count = document.getElementById("deal-count");
  const apply = (cat: string) => {
    let shown = 0;
    cards.forEach((t) => {
      const match = cat === "all" || t.dataset.category === cat;
      t.hidden = !match;
      if (match) {
        shown++;
        t.classList.add("in");
      }
    });
    filters?.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === cat)));
    if (count) count.textContent = `Showing ${shown} ${shown === 1 ? "device" : "devices"}`;
  };
  if (filters) {
    filters.hidden = false;
    filters.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest("button");
      if (b?.dataset.filter) apply(b.dataset.filter);
    });
  }
  document.querySelectorAll<HTMLAnchorElement>(".cat[data-filter]").forEach((a) =>
    a.addEventListener("click", () => apply(a.dataset.filter!)),
  );
  // Deep link from a product page breadcrumb: /?c=phones#deals opens that category.
  const initial = new URLSearchParams(location.search).get("c");
  if (initial && filters?.querySelector(`[data-filter="${CSS.escape(initial)}"]`)) apply(initial);

  // Generic links to the price list always show everything.
  document.querySelectorAll<HTMLAnchorElement>('a[href="#deals"]:not([data-filter]), a[href="/#deals"]:not([data-filter])').forEach((a) =>
    a.addEventListener("click", () => apply("all")),
  );

  // Swap / sell form: composes a WhatsApp message, nothing is sent anywhere else.
  const form = document.getElementById("swap-form") as HTMLFormElement | null;
  if (form) {
    const label = form.querySelector<HTMLElement>("[data-label]");
    const swapOnly = form.querySelectorAll<HTMLElement>("[data-swap-only]");
    const device = form.elements.namedItem("device") as HTMLInputElement;
    const err = document.getElementById("f-device-err");

    const sync = () => {
      const sell = (form.elements.namedItem("mode") as RadioNodeList).value === "sell";
      swapOnly.forEach((el) => {
        el.hidden = sell;
        el.querySelectorAll("input").forEach((i) => (i.disabled = sell));
      });
      if (label) label.textContent = sell ? "Get my cash offer" : "Get my swap value";
    };
    form.addEventListener("change", sync);
    sync();

    device.addEventListener("input", () => {
      if (device.value.trim()) {
        device.removeAttribute("aria-invalid");
        device.removeAttribute("aria-describedby");
        if (err) err.hidden = true;
      }
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const d = String(data.get("device") ?? "").trim();
      if (!d) {
        device.setAttribute("aria-invalid", "true");
        device.setAttribute("aria-describedby", "f-device-err");
        if (err) err.hidden = false;
        device.focus();
        return;
      }
      const sell = data.get("mode") === "sell";
      const want = String(data.get("want") ?? "").trim();
      const lines = [
        sell ? "Hi GreenTech, I want to sell my device for cash." : "Hi GreenTech, I want to swap my device.",
        `Device: ${d}`,
        `Condition: ${data.get("condition")}`,
      ];
      if (!sell && want) lines.push(`I want: ${want}`);
      lines.push("What can you offer?");
      // A real link click survives popup blockers and in-app browsers better than window.open.
      const a = Object.assign(document.createElement("a"), { href: waLink(lines.join("\n")), target: "_blank", rel: "noopener" });
      document.body.append(a);
      a.click();
      a.remove();
    });
  }
</script>
</Base>

<style>
  /* ---------- Shared section heading: Apple two-tone ---------- */
  .h2 { font-size: var(--text-3xl); font-weight: 600; letter-spacing: -0.025em; line-height: 1.08; max-width: 22ch; }
  .h2 .tone { display: block; color: var(--tone); }
  .tone-text { color: var(--muted); }
  .section { padding-block: var(--section-y); }
  .link { color: var(--green); font-weight: 500; text-decoration: none; }
  .link:hover { text-decoration: underline; text-underline-offset: 3px; }
  /* Links inside running text are underlined, so they don't rely on colour alone */
  p .link { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .fine { margin-top: 1.25rem; font-size: var(--text-sm); color: var(--muted); }

  /* ---------- Categories shelf ---------- */
  .cats { padding-bottom: 0; }
  .cats-row { margin-top: 2.25rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .cat {
    display: flex; flex-direction: column; gap: 0.9rem; text-decoration: none;
    padding: 0.5rem 0.5rem 1.1rem; border-radius: 1.6rem; background: var(--surface);
    box-shadow: 0 1px 2px rgba(var(--shadow-rgb) / 0.04), 0 6px 24px rgba(var(--shadow-rgb) / 0.06);
    transition: transform 500ms var(--ease-out), box-shadow 500ms var(--ease-out);
  }
  .cat-media { display: block; aspect-ratio: 4 / 3; border-radius: 1.15rem; overflow: hidden; background: var(--surface-2); }
  .cat-media :global(img) { width: 100%; height: 100%; object-fit: cover; filter: var(--photo-filter); transition: transform 700ms var(--ease-out); }
  .cat-text { display: grid; gap: 0.15rem; padding-inline: 0.75rem; }
  .cat-name { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; letter-spacing: -0.015em; }
  .cat-meta { font-size: 0.85rem; color: var(--muted); }
  @media (hover: hover) {
    .cat:hover { transform: translateY(-3px); box-shadow: 0 2px 4px rgba(var(--shadow-rgb) / 0.05), 0 18px 40px rgba(var(--shadow-rgb) / 0.1); }
    .cat:hover .cat-media :global(img) { transform: scale(1.04); }
  }
  @media (max-width: 760px) { .cats-row { grid-template-columns: 1fr 1fr; gap: 0.75rem; } }

  /* ---------- Why: bento ---------- */
  .bento { margin-top: 2.25rem; display: grid; grid-template-columns: 1.4fr 1fr; grid-template-rows: auto auto; gap: 1rem; }
  .tile { border-radius: 1.5rem; background: var(--surface); box-shadow: 0 1px 2px rgba(var(--shadow-rgb) / 0.04), 0 6px 24px rgba(var(--shadow-rgb) / 0.06); }
  .tile-big { grid-row: span 2; }
  .tile-core { height: 100%; display: flex; flex-direction: column; gap: 0.75rem; padding: clamp(1.5rem, 3vw, 2.25rem); }
  .tile-kicker { font-size: 0.85rem; font-weight: 600; color: var(--green); }
  .tile h3 { font-size: 1.375rem; font-weight: 600; letter-spacing: -0.015em; line-height: 1.2; }
  .tile-big h3 { font-size: var(--text-2xl); line-height: 1.12; max-width: 20ch; }
  .tile p { color: var(--muted); max-width: 46ch; }
  .checks { list-style: none; padding: 0; margin: auto 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; padding-top: 1.5rem; }
  .checks li { padding: 0.45rem 0.9rem; border-radius: 999px; background: var(--green-soft); color: var(--ok); font-size: 0.85rem; font-weight: 600; }
  .checks li::before { content: "✓ "; content: "✓ " / ""; }
  @media (max-width: 860px) { .bento { grid-template-columns: 1fr; } .tile-big { grid-row: auto; } }

  /* ---------- Deals ---------- */
  .deals-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.25rem 2rem; }
  .deals-sub { margin-top: 1rem; color: var(--muted); max-width: 52ch; }
  .deals-sub b { color: var(--text); font-weight: 600; }
  .filters { display: flex; gap: 0.25rem; padding: 0.25rem; border-radius: 999px; background: var(--surface-2); overflow-x: auto; scrollbar-width: none; max-width: 100%; }
  @media (max-width: 640px) { .filters { -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent); mask-image: linear-gradient(90deg, #000 85%, transparent); } }
  .filters::-webkit-scrollbar { display: none; }
  .filters[hidden] { display: none; }
  .filters button {
    flex: none; min-height: 2.5rem; padding: 0 1.1rem; border: 0; border-radius: 999px; background: transparent;
    color: var(--muted); cursor: pointer; font-size: 0.9rem; font-weight: 500;
    transition: background-color var(--dur-fast), color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .filters button:hover { color: var(--text); }
  .filters button[aria-pressed="true"] { background: var(--surface); color: var(--text); box-shadow: inset 0 0 0 1.5px var(--green), 0 1px 3px rgba(var(--shadow-rgb) / 0.12); }
  .deal-grid { margin-top: 2rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(16.5rem, 1fr)); gap: 1rem; }
  @media (max-width: 640px) { .deal-grid { grid-template-columns: 1fr 1fr; gap: 0.6rem; } }
  .more { margin-top: 2.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 2rem; padding: 1.4rem 1.6rem; border-radius: 1.4rem; background: var(--surface); }
  .more b { font-weight: 600; }

  /* ---------- Condition ---------- */
