---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import MiniHeader from "../../components/MiniHeader.astro";
import ProductCard from "../../components/ProductCard.astro";
import { POUCH_ID, findProduct, products, type Product } from "../../data/products";
import { NIGERIAN_STATES } from "../../data/states";
import { amount, naira, orderMessage, site, waLink } from "../../data/site";

export const getStaticPaths = (() => products.map((product) => ({ params: { id: product.id }, props: { product } }))) satisfies GetStaticPaths;

const { product } = Astro.props as { product: Product };
const pouchItem = findProduct(POUCH_ID);
const pouch = product.category === "phones" && pouchItem && !pouchItem.sold ? pouchItem : undefined;
---
<Base title={`Buy ${product.name} | ${site.shortName}`} description={`Checkout: ${product.name} (${product.condition}), ${naira(product.price)}.`} noindex>
  <MiniHeader help={`Hi GreenTech, I need help buying the ${product.name}.`} />
  <main id="main" class="wrap checkout">
    <a class="back" href="/#deals">← All prices</a>

    <div class="co-grid">
      <aside class="order-summary">
        <p class="eyebrow">Your order</p>
        <ProductCard product={product} variant="summary" />
        <ul class="facts">
          <li><b>You pay now:</b> <span class="cur">₦</span>{amount(product.price)}, the device price{pouch ? ", plus the pouch if you add it" : ""}. Nothing else is added at checkout.</li>
          <li><b>Delivery:</b> if you choose delivery, we agree the fee with you on WhatsApp and you pay it separately. Pickup at our shop costs nothing extra.</li>
          <li><b>Payment:</b> on Paystack's secure page. GreenTech never sees your card details.</li>
          <li><b>If it's sold out:</b> if the unit sells before we confirm your order, we tell you on WhatsApp and refund you in full.</li>
        </ul>
        <p class="ask">Want to see the unit first? <a href={waLink(orderMessage(product))} target="_blank" rel="noopener">Ask for a live video on WhatsApp</a></p>
      </aside>

      {product.sold ? (
        <div class="co-form sold-note" id="form">
          <h1>This one has sold.</h1>
          <p>Message us and we'll find you a similar {product.name}, or show you what's in stock today.</p>
          <a class="btn btn-primary btn-lg pay" href={waLink(`Hi GreenTech, the ${product.name} has sold. Do you have a similar one?`)} target="_blank" rel="noopener">Ask for a similar one on WhatsApp</a>
        </div>
      ) : (
      <form class="co-form" id="form" method="post" action="/api/checkout">
        <h1>Your details</h1>
        <p class="form-error" id="form-error" role="alert" tabindex="-1" hidden></p>
        <input type="hidden" name="item" value={product.id} />
        <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>

        <div class="field">
          <label for="c-name">Full name</label>
          <input id="c-name" name="name" required minlength="2" maxlength="100" autocomplete="name" />
        </div>
        <div class="field">
          <label for="c-phone">Phone (WhatsApp)</label>
          <input id="c-phone" name="phone" type="tel" required inputmode="tel" pattern="\+?[0-9 ()\-]{7,20}" autocomplete="tel" placeholder="0803 123 4567" />
        </div>
        <div class="field">
          <label for="c-email">Email <span class="opt">(Paystack sends your receipt here)</span></label>
          <input id="c-email" name="email" type="email" required maxlength="254" autocomplete="email" />
        </div>

        <fieldset class="mode">
          <legend class="sr-only">How do you want to get it?</legend>
          <label><input type="radio" name="fulfilment" value="pickup" checked /> <span>Pick up in Ikeja</span></label>
          <label><input type="radio" name="fulfilment" value="delivery" /> <span>Deliver to me</span></label>
        </fieldset>

        <div class="field" data-delivery>
          <label for="c-address">Delivery address <span class="opt no-js-only">(delivery only)</span></label>
          <input id="c-address" name="address" maxlength="200" autocomplete="street-address" placeholder="House number, street, area" />
        </div>
        <div class="field" data-delivery>
          <label for="c-state">State <span class="opt no-js-only">(delivery only)</span></label>
          <select id="c-state" name="state" autocomplete="address-level1">
            <option value="">Choose a state</option>
            {NIGERIAN_STATES.map((s) => <option>{s}</option>)}
          </select>
        </div>
        <p class="pickup-note" data-pickup hidden>Collect it at {site.address}, {site.hours}. We'll message you on WhatsApp when it's ready.</p>

        {pouch && (
          <label class="addon">
            <input type="checkbox" name="addPouch" value="1" data-addon={pouch.price} />
            <span>
              <b>Add a {pouch.name.toLowerCase()}</b>
              <span class="addon-meta">+<span class="cur">₦</span>{amount(pouch.price)}. Brand new, fitted for this phone.</span>
            </span>
          </label>
        )}

        <div class="field">
          <label for="c-notes">Anything we should know? <span class="opt">(optional)</span></label>
          <textarea id="c-notes" name="notes" maxlength="500" rows="3"></textarea>
        </div>

        <button class="btn btn-primary btn-lg pay" type="submit">
          <span>Pay <span class="cur">₦</span><span data-total={product.price}>{amount(product.price)}</span> with Paystack</span>
        </button>
        <p class="form-note">You'll go to Paystack to pay, then come back here for your confirmation.</p>
      </form>
      )}
    </div>
  </main>

  <script>
    // The sold-out version of this page has no form.
    const form = document.querySelector<HTMLFormElement>("form#form");
    if (form) {
      const KEY = "gt-checkout";
      const errors: Record<string, [string, string]> = {
        "field-name": ["name", "Please enter your full name."],
        "field-phone": ["phone", "Please enter a phone number we can reach you on, e.g. 0803 123 4567."],
        "field-email": ["email", "Please enter a valid email address for your receipt."],
        "field-address": ["address", "Please enter your delivery address."],
        "field-state": ["state", "Please choose your state."],
        "field-notes": ["notes", "Please keep your note under 500 characters."],
        "pouch-sold": ["addPouch", "Sorry, the pouch has just sold out. Untick it to buy the phone on its own, or ask us on WhatsApp."],
      sold: ["", "Sorry, this unit has just sold. Message us on WhatsApp and we'll find you a similar one."],
        gateway: ["", "We couldn't reach Paystack just now. Please try again in a moment, or order on WhatsApp."],
        busy: ["", "Too many attempts from your connection. Please wait a few minutes and try again, or order on WhatsApp."],
        unavailable: ["", "Online payment isn't available right now. Please order on WhatsApp and we'll sort you out."],
      };

      const delivery = form.querySelectorAll<HTMLElement>("[data-delivery]");
      const pickup = form.querySelector<HTMLElement>("[data-pickup]")!;
      const sync = () => {
        const isDelivery = (form.elements.namedItem("fulfilment") as RadioNodeList).value === "delivery";
        delivery.forEach((el) => {
          el.hidden = !isDelivery;
          el.querySelector<HTMLInputElement | HTMLSelectElement>("input, select")!.required = isDelivery;
        });
        pickup.hidden = isDelivery;
      };
      document.querySelectorAll(".no-js-only").forEach((el) => el.remove());

      // After a server-side rejection, restore what the buyer typed and point at the problem.
      const code = new URLSearchParams(location.search).get("error");
      if (code) {
        try {
          const saved = JSON.parse(sessionStorage.getItem(KEY) ?? "{}") as Record<string, string>;
          for (const [k, v] of Object.entries(saved)) {
            const el = form.elements.namedItem(k);
            if (el instanceof HTMLInputElement && el.type === "checkbox") el.checked = v === "1";
            else if (el instanceof RadioNodeList) el.value = v;
            else if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement) el.value = v;
          }
        } catch {}
        const [field, message] = errors[code] ?? ["", "Something went wrong. Please try again."];
        const box = document.getElementById("form-error")!;
        box.textContent = message;
        box.hidden = false;
        const input = field ? (form.elements.namedItem(field) as HTMLElement | null) : null;
        input?.setAttribute("aria-invalid", "true");
        input?.addEventListener("input", () => input.removeAttribute("aria-invalid"), { once: true });
        (input ?? box).focus?.();
      }
      // Don't keep the buyer's details in the browser longer than one retry needs.
      if (!code) { try { sessionStorage.removeItem(KEY); } catch {} }
      form.addEventListener("change", sync);
      sync();

      // Live total on the pay button when the pouch add-on is ticked.
      const totalEl = form.querySelector<HTMLElement>("[data-total]");
      const addon = form.querySelector<HTMLInputElement>("[data-addon]");
      const showTotal = () => {
        if (!totalEl) return;
        const total = Number(totalEl.dataset.total) + (addon?.checked ? Number(addon.dataset.addon) : 0);
        totalEl.textContent = total.toLocaleString("en-NG");
      };
      addon?.addEventListener("change", showTotal);
      showTotal();

      form.addEventListener("submit", () => {
        const data: Record<string, string> = {};
        new FormData(form).forEach((v, k) => k !== "item" && (data[k] = String(v)));
        try { sessionStorage.setItem(KEY, JSON.stringify(data)); } catch {}
        const btn = form.querySelector<HTMLButtonElement>(".pay")!;
        btn.disabled = true;
        btn.textContent = "Taking you to Paystack…";
      });
      // Re-enable if the buyer comes back with the browser's Back button.
      addEventListener("pageshow", (e) => {
        if (e.persisted) location.reload();
      });
    }
  </script>
</Base>

<style>
  .checkout { padding-block: 2rem 5rem; }
  .back { color: var(--muted); font-size: var(--text-sm); text-decoration: none; }
  .back:hover { color: var(--green); }
  .co-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; margin-top: 1.5rem; }
  .order-summary { display: grid; gap: 1.25rem; position: sticky; top: 1.5rem; }
  .facts { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; color: var(--muted); font-size: var(--text-sm); }
  .facts b { color: var(--text); }
  .ask { font-size: var(--text-sm); color: var(--muted); }
  .ask a { color: var(--green); }
  .co-form { display: grid; gap: 1.1rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(1.25rem, 3vw, 2.25rem); }
  .co-form h1 { font-size: var(--text-2xl); }
  .form-error { padding: 0.85rem 1rem; border-radius: var(--radius-sm); background: rgba(255, 122, 122, 0.1); border: 1px solid rgba(255, 122, 122, 0.4); color: #ffb3b3; font-size: var(--text-sm); }
  .form-error[hidden], .pickup-note[hidden] { display: none; }
  .pickup-note { font-size: var(--text-sm); color: var(--muted); margin-top: -0.25rem; }
  .pay { width: 100%; margin-top: 0.4rem; }
  .addon { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.9rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--line-strong); background: var(--bg); cursor: pointer; }
  .addon input { width: 1.15rem; height: 1.15rem; margin-top: 0.15rem; accent-color: var(--green); flex: none; }
  .addon b { display: block; font-weight: 600; }
  .addon-meta { font-size: var(--text-sm); color: var(--muted); }
  .addon:has(input:checked) { border-color: var(--green); background: color-mix(in srgb, var(--green) 6%, var(--bg)); }
  .sold-note { gap: 0.9rem; }
  .sold-note p { color: var(--muted); }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .pay:disabled { opacity: 0.7; cursor: progress; }
  .form-note { font-size: 0.82rem; color: var(--muted); text-align: center; }
  @media (max-width: 860px) {
    .co-grid { grid-template-columns: 1fr; }
    .order-summary { position: static; }
  }
</style>
