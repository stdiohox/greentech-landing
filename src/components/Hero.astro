---
import { Image } from "astro:assets";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import type { Product } from "../data/products";
import { amount, orderMessage, waLink } from "../data/site";
import iphoneImg from "../assets/hero/iphone.jpg";
import ps5Img from "../assets/hero/ps5.jpg";

// Only photos that show the actual model on sale.
const photos: Record<string, { src: ImageMetadata; alt: string; pos: string }> = {
  "iphone-14-pro-max-128gb": { src: iphoneImg, alt: "iPhones on a white desk beside an iPhone 14 Pro box", pos: "42% 30%" },
  "ps5-disc": { src: ps5Img, alt: "PlayStation 5 console standing upright", pos: "48% 40%" },
};

interface Props { picks: Product[]; hello: string }
const { picks, hello } = Astro.props;
const short = (name: string) => name.split(" ")[0];
for (const p of picks) if (!photos[p.id]) throw new Error(`Hero: no accurate photo for "${p.id}"`);
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="copy">
      <p class="where hero-in" style="--d:0"><span class="dot" aria-hidden="true"></span>Computer Village, Ikeja<span class="sep" aria-hidden="true">·</span>Open Mon–Sat</p>
      <h1 id="hero-title" class="hero-in" style="--d:1">
        Tested gadgets.<br /><span class="tone">Honest prices.</span>
      </h1>
      <p class="sub hero-in" style="--d:2">
        UK-used and brand-new phones, laptops and consoles, checked by us and priced on the page.
        Buy online, swap your old device, or just ask us on WhatsApp.
      </p>
      <div class="ctas hero-in" style="--d:3">
        <a class="btn btn-primary btn-lg cta-main" href="#deals">See today's prices</a>
        <a class="text-link" href={hello} target="_blank" rel="noopener">
          <WhatsAppIcon /> Chat on WhatsApp <span aria-hidden="true">›</span>
        </a>
      </div>
    </div>

    <div class="stage hero-in" style="--d:2">
      <div class="bezel">
        <div class="photo">
          {picks.map((p, i) => (
            <Image
              src={photos[p.id].src}
              alt={photos[p.id].alt}
              widths={[480, 720, 1000, 1400]}
              sizes="(max-width: 900px) 88vw, 560px"
              loading="eager"
              fetchpriority={i === 0 ? "high" : "low"}
              data-photo={i}
              class:list={{ on: i === 0 }}
              style={`object-position:${photos[p.id].pos}`}
              aria-hidden={i === 0 ? undefined : "true"}
            />
          ))}
        </div>
      </div>

      <div class="pick" data-pick>
        <div class="pick-tabs" role="tablist" aria-label="Today's picks">
          {picks.map((p, i) => (
            <button type="button" role="tab" id={`pick-tab-${i}`} aria-controls={`pick-${i}`} aria-selected={i === 0 ? "true" : "false"} aria-label={p.name} tabindex={i === 0 ? 0 : -1}>
              {short(p.name)}
            </button>
          ))}
        </div>
        <div class="pick-panels">
        {picks.map((p, i) => (
          <div class="pick-panel" id={`pick-${i}`} role="tabpanel" aria-labelledby={`pick-tab-${i}`} hidden={i !== 0}>
            <div class="pick-head">
              <span class:list={["badge", p.condition === "Brand New" ? "badge-new" : "badge-used"]}>{p.condition === "Brand New" ? "Brand new" : "UK used"}</span>
              <span class="pick-label">Today's pick</span>
            </div>
            <p class="pick-name">{p.name}</p>
            <p class="pick-specs">{p.specs.join("\u2002·\u2002")}</p>
            <div class="pick-foot">
              <p class="pick-price"><span class="sr-only">Price: </span><span class="cur">₦</span>{amount(p.price)}</p>
              <div class="pick-actions">
                <a class="btn btn-primary pick-buy" href={`/checkout/${p.id}`}>Buy<span class="sr-only"> {p.name}</span></a>
                <a class="btn btn-ghost pick-ask" href={waLink(orderMessage(p))} target="_blank" rel="noopener" aria-label={`Ask about ${p.name} on WhatsApp`}><WhatsAppIcon /></a>
              </div>
            </div>
          </div>
        ))}
        </div>
      </div>
    </div>
  </div>

</section>

<script>
  // Today's picks: an accessible tablist. No auto-rotation: the visitor chooses.
  const root = document.querySelector<HTMLElement>("[data-pick]");
  if (root) {
    const tablist = root.querySelector<HTMLElement>("[role=tablist]")!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[role=tabpanel]")];
    const photos = [...document.querySelectorAll<HTMLImageElement>("[data-photo]")];
    let current = 0;

    const show = (i: number, focus = false) => {
      current = (i + tabs.length) % tabs.length;
      tabs.forEach((t, j) => {
        t.setAttribute("aria-selected", String(j === current));
        t.tabIndex = j === current ? 0 : -1;
      });
      panels.forEach((p, j) => (p.hidden = j !== current));
      photos.forEach((img, j) => {
        img.classList.toggle("on", j === current);
        if (j === current) img.removeAttribute("aria-hidden");
        else img.setAttribute("aria-hidden", "true");
      });
      if (focus) tabs[current].focus();
    };

    tabs.forEach((t, i) => t.addEventListener("click", () => show(i)));
    tablist.addEventListener("keydown", (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      const keys: Record<string, number> = { ArrowRight: current + 1, ArrowLeft: current - 1, Home: 0, End: tabs.length - 1 };
      if (e.key in keys) {
        e.preventDefault();
        show(keys[e.key], true);
      }
    });
  }
</script>

<style>
  .hero { padding-top: clamp(2.5rem, 6vw, 5rem); }
  .hero-grid { display: grid; grid-template-columns: 1.02fr 1fr; gap: clamp(2.5rem, 6vw, 5.5rem); align-items: start; }
  .copy { padding-top: clamp(0rem, 6vw, 4.5rem); }
  .hero-grid > * { min-width: 0; }
  .sep { margin-inline: 0.5em; opacity: 0.6; }

  .where { display: inline-flex; align-items: center; gap: 0.55rem; font-size: var(--text-sm); color: var(--muted); font-weight: 500; }
  .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 4px var(--green-soft); }

  h1 {
    margin-top: 1.25rem;
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-variation-settings: "opsz" 96;
  }
  .tone { color: var(--tone); }
  .sub { margin-top: 1.4rem; max-width: 40ch; font-size: var(--text-lg); line-height: 1.55; color: var(--muted); }

  .ctas { margin-top: 2.2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.75rem; }
  .btn-lg { --h: 3rem; padding: 0 1.5rem; font-size: 1.0625rem; font-weight: 500; }
  .text-link { display: inline-flex; align-items: center; gap: 0.45rem; color: var(--green); font-size: 1.0625rem; font-weight: 500; text-decoration: none; }
  .text-link :global(svg) { width: 1.1em; height: 1.1em; }
  .text-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* Photo in a double bezel, with the pick card overlapping its lower edge */
  .stage { position: relative; }
  .bezel { padding: 0.5rem; border-radius: var(--radius-lg); background: color-mix(in srgb, var(--surface-2) 70%, transparent); border: 1px solid color-mix(in srgb, var(--line) 70%, transparent); }
  .photo { position: relative; aspect-ratio: 1 / 1; overflow: hidden; border-radius: calc(var(--radius-lg) - 0.5rem); background: var(--surface-2); }
  .photo :global(img) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: var(--photo-filter); opacity: 0; transition: opacity 600ms var(--ease-out);
  }
  .photo :global(img.on) { opacity: 1; }
  .photo::after { content: ""; position: absolute; inset: 50% 0 0; background: linear-gradient(to top, rgba(var(--shadow-rgb) / 0.35), transparent); }

  .pick {
    position: relative;
    z-index: 2;
    margin: -4.5rem 1.25rem 0;
    padding: 1.25rem;
    border-radius: 1.5rem;
    background: var(--surface);
    box-shadow: 0 1px 2px rgba(var(--shadow-rgb) / 0.05), 0 4px 24px rgba(var(--shadow-rgb) / 0.1);
  }
  .pick-tabs { display: flex; gap: 0.25rem; padding: 0.25rem; border-radius: 999px; background: var(--surface-2); margin-bottom: 1rem; }
  :global(html:not(.js)) .pick-tabs { display: none; }
  .pick-tabs button {
    flex: 1; min-height: 2.2rem; padding: 0 0.6rem; border: 0; border-radius: 999px; background: transparent;
    min-width: 0;
    font-size: 0.82rem; font-weight: 600; color: var(--muted); cursor: pointer;
    transition: background-color var(--dur-fast), color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .pick-tabs button[aria-selected="true"] { background: var(--surface); color: var(--text); box-shadow: inset 0 0 0 1.5px var(--green), 0 1px 3px rgba(var(--shadow-rgb) / 0.12); }
  /* All panels share one grid cell, so the card keeps the tallest panel's height and never jumps */
  .pick-panels { display: grid; }
  .pick-panel { grid-area: 1 / 1; animation: pick-in 420ms var(--ease-out); }
  .pick-panel[hidden] { display: block; visibility: hidden; animation: none; }
  @keyframes pick-in { from { opacity: 0; transform: translateY(6px); } }
  .pick-head { display: flex; align-items: center; justify-content: space-between; }
  .pick-label { font-size: 0.75rem; color: var(--muted); font-weight: 500; }
  .badge { display: inline-block; padding: 0.25rem 0.65rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; }
  .badge-new { background: var(--green-soft); color: var(--ok); }
  .badge-used { background: color-mix(in srgb, var(--warn) 14%, transparent); color: var(--warn); }
  .pick-name { margin-top: 0.7rem; font-family: var(--font-display); font-weight: 600; font-size: 1.35rem; letter-spacing: -0.02em; line-height: 1.1; }
  .pick-specs { margin-top: 0.3rem; font-size: 0.86rem; color: var(--muted); }
  .pick-foot { margin-top: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .pick-price { font-family: var(--font-display); font-weight: 600; font-size: 1.6rem; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .pick-price :global(.cur) { font-weight: 600; }
  .pick-actions { display: flex; gap: 0.4rem; }
  .pick-buy { --h: 2.75rem; padding: 0 1.4rem; }
  .pick-ask { --h: 2.75rem; width: 2.75rem; padding: 0; }

  .hero-in { animation: rise 800ms var(--ease-out) both; animation-delay: calc(var(--d) * 80ms); }
  @keyframes rise { from { transform: translateY(16px); } }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .photo { aspect-ratio: 4 / 3; }
    .pick { margin: -3.5rem 0.75rem 0; }
  }
  @media (max-width: 420px) {
    .pick-tabs button { font-size: 0.75rem; padding: 0 0.35rem; }
    .pick-name { font-size: 1.2rem; }
    .pick-price { font-size: 1.35rem; }
  }
</style>
